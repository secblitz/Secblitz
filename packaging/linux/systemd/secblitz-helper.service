[Unit]
Description=Secblitz helper
Documentation=https://secblitz.lol

[Service]
Type=dbus
BusName=org.secblitz.Helper1
ExecStart=/usr/bin/secblitz helper
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=read-only
StateDirectory=secblitz
StateDirectoryMode=0700
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
