[Unit]
Description=Secblitz web protection
Documentation=https://secblitz.lol
After=network.target systemd-resolved.service
ConditionPathExists=/usr/bin/secblitz

[Service]
Type=notify
ExecStart=/usr/bin/secblitz filter run
# These two run as root, outside the sandbox below. Lookups are sent to the filter only after it says it is answering,
# and the setting is taken away whenever it stops or crashes, so the computer is never left without working lookups.
ExecStartPost=-+/usr/bin/secblitz filter add-rule
ExecStopPost=-+/usr/bin/secblitz filter remove-rule
Restart=on-failure
RestartSec=30
TimeoutStartSec=20
User=secblitz-filter
Group=secblitz-filter
StateDirectory=secblitz-filter
StateDirectoryMode=0700
UMask=0077
RemoveIPC=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
