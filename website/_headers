/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; media-src 'self'; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000
  Cache-Control: no-transform

/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/install.sh
  Content-Type: text/plain; charset=utf-8
  Cache-Control: no-cache

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/downloads/*
  Content-Type: application/octet-stream
  Content-Disposition: attachment
  Cache-Control: no-cache

/releases/*
  Cache-Control: no-store
